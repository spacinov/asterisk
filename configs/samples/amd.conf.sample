;
; Answering Machine Detection Configuration
;

[general]
total_analysis_time = 5000	; Maximum time allowed for the algorithm to decide
				; on whether the audio represents a HUMAN, or a MACHINE
silence_threshold = 256		; If the average level of noise in a sample does not reach
				; this value, from a scale of 0 to 32767, then we will consider
				; it to be silence.
;playback_file = 		; Audio file to play while AMD is running, so the caller
				; does not just hear silence. Note that specifying this here
				; will apply to ALL AMD runs, so you may wish to set it
				; in the dialplan as an argument to AMD() instead.
				; Default is no audio file (not to play anything).

; Greeting ;
initial_silence = 2500		; Maximum silence duration before the greeting.
				; If exceeded, then the result is detection as a MACHINE.
after_greeting_silence = 800	; Silence after detecting a greeting.
				; If exceeded, then the result is detection as a HUMAN
greeting = 1500			; Maximum length of a greeting. If exceeded, then the
				; result is detection as a MACHINE.

; Word detection ;
min_word_length = 100		; Minimum duration of Voice to considered as a word
maximum_word_length = 5000	; Maximum duration of a single Voice utterance allowed.
between_words_silence = 50	; Minimum duration of silence after a word to consider
				; the audio what follows as a new word

maximum_number_of_words = 2	; Maximum number of words in the greeting
				; If exceeded, then the result is detection as a MACHINE

; Known prompt detection ;
;
; When enabled here, AMD() also matches the caller's audio against references
; of known call screening prompts, such as the one recent iOS versions play
; before connecting a human, and returns AMDSTATUS=SCREENED with
; AMDCAUSE=SIGNATURE-<reference>-<score> as soon as one matches. Without this,
; AMD() classifies those prompts as MACHINE, because on energy and timing
; features they are one. The match typically comes several hundred
; milliseconds before AMD() would have reached MACHINE on the same audio.
;
; The references are the .sig files in the amd/<language>/ directory under
; the configuration directory, for example /etc/asterisk/amd/fr/, and a call
; is matched against those of its channel language: set CHANNEL(language)
; before calling AMD(). A language with a dialect, such as fr_CA, falls back to
; fr when it has no directory of its own. A call in a language without
; references runs plain AMD, with a warning the first time. A handset plays
; the prompt in its own language, which need not be the channel's: to match
; another language's prompts too, link its files into the directory.
;
; A handset plays the prompt in whichever voice it is set to, so there is one
; reference per voice. contrib/scripts/amd_signature_sweep.py makes them from
; labelled calls, as doc/amd-signature.txt describes. References are loaded on
; the first call in a language after a reload, and "module reload app_amd"
; picks up added, replaced and removed files.
;
; Without this section AMD() behaves exactly as it always has.
;
; "amd signature test" scores recordings against a reference from the CLI, and
; "amd signature show templates" lists the references of each language.
;
;[signature]
;enabled = yes			; Match the audio against the references of the call's
				; language. Default no.
;threshold = 95			; Similarity, from 0 to 100, at or above which a reference is
				; considered to match. Decimals are allowed.
;template_length = 3000		; How much of each reference to align with the call, in
				; milliseconds from its start. A call is matched against any
				; stretch of it, so a longer reference tolerates more of the
				; prompt being missing from the call, which is what happens
				; when a call is answered late. 3000 covers being up to 1800ms
				; late; beyond that adds nothing.
;match_window = 1200		; How much of the reference, in milliseconds, a match must
				; cover before it counts. Lower gives a faster verdict, but
				; 1200 is the shortest that keeps the threshold forgiving:
				; below it the useful range becomes a knife edge rather than
				; a broad plateau.
;silence_threshold = 256	; Minimum mean sample level, on a scale of 0 to 32767, over
				; the last match_window of audio for a match to count.
				; Matching ignores absolute level so that a quiet prompt
				; matches a loud reference, which means near silence also has
				; a shape and can score deceptively high. Same measure and
				; default as silence_threshold in [general].
